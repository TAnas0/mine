---
import { Image } from "astro:assets";
import { profile } from "../../settings";
import SocialIcons from "./SocialIcons.astro";
import ProfilePictures from "@/assets/elfowl.png";
import { getCollection } from "astro:content";
import { template } from "@/settings";

const isBlogPopulated = await getCollection("blog").then(
	(collection) => collection.length > 0,
);

const { fullName } = profile;

const pathname = Astro.url.pathname.replace(/\/$/, "");

const isActive = (path: string) => {
	const normalizedPath = path.replace(/\/$/, "");
	if (normalizedPath === template.base) {
		return pathname === template.base || pathname === "";
	}
	return pathname.startsWith(normalizedPath);
};

const activeClass = "text-primary font-semibold";
const linkClass = "font-mono text-sm tracking-wide hover:text-primary";
---

<aside
	class="flex h-screen w-[16rem] flex-col border-r border-base-content/10 bg-base-100 px-4 py-8 text-base-content lg:w-[18rem]"
>
	<div class="flex h-full flex-col justify-between overflow-hidden">
		<div>
			<div class="flex flex-col items-center">
				<div class="relative h-16 w-16">
					<Image
						class="relative h-full w-full rounded-full grayscale"
						src={ProfilePictures}
						alt={`Profile picture of ${fullName}`}
					/>
				</div>
				<p class="mt-4 whitespace-nowrap font-mono text-sm tracking-wide">
					A. Lexian
				</p>
			</div>

			<ul class="menu menu-md mt-10 space-y-1">
				<li>
					<a
						href={`${template.base}/`}
						class={`${linkClass} ${isActive(`${template.base}/`) ? activeClass : ""}`}
					>
						Home
					</a>
				</li>
				{
					isBlogPopulated && (
						<li>
							<a
								href={`${template.base}/blog/1`}
								class={`${linkClass} ${isActive(`${template.base}/blog`) ? activeClass : ""}`}
							>
								Articles
							</a>
						</li>
					)
				}
				<li>
					<a
						href={`${template.base}/contact`}
						class={`${linkClass} ${isActive(`${template.base}/contact`) ? activeClass : ""}`}
					>
						Contact
					</a>
				</li>
				<li>
					<a
						href={`${template.base}/schedulecall`}
						class={`${linkClass} ${isActive(`${template.base}/schedulecall`) ? activeClass : ""}`}
					>
						Chat sometime?
					</a>
				</li>
			</ul>
		</div>

		<div class="mx-2">
			<SocialIcons />
		</div>
	</div>
</aside>
