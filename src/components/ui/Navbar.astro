---
import { profile } from "../../settings";
import SocialIcons from "./SocialIcons.astro";
import { getCollection } from "astro:content";
import { template } from "@/settings";
import { filterPublishedPosts } from "@/lib/blog";

const publishedPosts = filterPublishedPosts(await getCollection("blog"));
const isBlogPopulated = publishedPosts.length > 0;

// Count tags by frequency
const tagCounts = new Map<string, number>();
for (const post of publishedPosts) {
	for (const tag of post.data.tags ?? []) {
		tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
	}
}

// Order tags by frequency (most frequent first), then alphabetically
const popularTags = Array.from(tagCounts.entries())
	.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
	.slice(0, 8);

const { fullName } = profile;

const pathname = Astro.url.pathname.replace(/\/$/, "");

const isActive = (path: string) => {
	const normalizedPath = path.replace(/\/$/, "");
	if (normalizedPath === template.base) {
		return pathname === template.base || pathname === "";
	}
	return pathname.startsWith(normalizedPath);
};

const activeClass = "text-secondary font-semibold";
const linkClass = "font-mono text-sm tracking-wide hover:text-secondary transition-colors";
---

<aside
	class="flex h-screen w-[16rem] flex-col border-r border-base-content/10 bg-base-100 px-4 py-8 text-base-content lg:w-[18rem]"
>
	<div class="flex h-full flex-col justify-between overflow-y-auto">
		<div>
			<div class="flex flex-col items-center">
				<p class="font-mono text-base font-semibold tracking-wide">
					{fullName}
				</p>
			</div>

			<ul class="menu menu-md mt-8 space-y-1">
				<li>
					<a
						href={`${template.base}/`}
						class={`${linkClass} ${isActive(`${template.base}/`) ? activeClass : ""}`}
					>
						Home
					</a>
				</li>
				{
					isBlogPopulated && (
						<li>
							<a
								href={`${template.base}/blog/1`}
								class={`${linkClass} ${isActive(`${template.base}/blog`) && !Astro.url.searchParams.get("tag") ? activeClass : ""}`}
							>
								Articles
							</a>
							{popularTags.length > 0 && (
								<ul class="my-1.5 space-y-0.5 border-l border-base-content/15 pl-3">
									{popularTags.map(([tag, count]) => {
										const tagPath = `${template.base}/blog/1?tag=${encodeURIComponent(tag)}`;
										const isSelected =
											pathname.includes("/blog") &&
											Astro.url.searchParams.get("tag") === tag;
										return (
											<li>
												<a
													href={tagPath}
													class={`flex items-center justify-between py-1 font-mono text-xs tracking-wide hover:text-secondary ${
														isSelected
															? "font-semibold text-secondary"
															: "text-base-content/70"
													}`}
												>
													<span>#{tag}</span>
													<span class="rounded bg-base-200 px-1.5 py-0.5 font-mono text-[10px] text-base-content/50">
														{count}
													</span>
												</a>
											</li>
										);
									})}
								</ul>
							)}
						</li>
					)
				}
				<li>
					<a
						href={`${template.base}/contact`}
						class={`${linkClass} ${isActive(`${template.base}/contact`) ? activeClass : ""}`}
					>
						Contact & Schedule
					</a>
				</li>
			</ul>
		</div>

		<div class="mx-2 mt-8">
			<SocialIcons />
		</div>
	</div>
</aside>
