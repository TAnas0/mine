<div
  class="prose
  md:prose-lg
  lg:prose-xl
  max-w-none
  mx-auto
  dark:prose-invert
  
  /* Typography */
  prose-headings:font-bold
  prose-headings:tracking-tight
  prose-headings:text-base-content
  prose-p:leading-relaxed
  prose-p:text-base-content/90
  prose-strong:font-bold
  prose-strong:text-base-content
  
  /* Links */
  prose-a:text-accent
  prose-a:no-underline
  prose-a:border-b-2
  prose-a:border-accent/20
  hover:prose-a:border-accent
  prose-a:transition-all
  prose-a:duration-200
  
  /* Blockquotes */
  prose-blockquote:border-l-4
  prose-blockquote:border-accent
  prose-blockquote:bg-base-200/50
  prose-blockquote:py-2
  prose-blockquote:px-5
  prose-blockquote:rounded-r-lg
  prose-blockquote:not-italic
  prose-blockquote:font-medium
  prose-blockquote:text-base-content/80
  
  /* Images */
  prose-img:rounded-2xl
  prose-img:shadow-xl
  prose-img:mx-auto
  prose-img:my-8
  
  /* Lists */
  prose-li:marker:text-accent
  
  /* Code */
  prose-code:bg-base-300
  prose-code:px-1.5
  prose-code:py-0.5
  prose-code:rounded-md
  prose-code:font-normal
  prose-code:text-base-content/90
  prose-code:before:content-none
  prose-code:after:content-none
  
  /* Pre (Code Blocks) */
  prose-pre:shadow-lg
  prose-pre:border
  prose-pre:border-base-content/5
  prose-pre:rounded-xl"
>
  <slot />
</div>
