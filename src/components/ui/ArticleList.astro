---
import { getCollection } from "astro:content";
import { blogPostToPreview, sortPostsByDate } from "@/lib/blog";
import ArticleCard from "./ArticleCard.astro";

interface Props {
	listTitle: string;
	limit?: number;
}

const { listTitle, limit } = Astro.props;

const posts = sortPostsByDate(
	(await getCollection("blog")).map(blogPostToPreview),
);

const visiblePosts = limit ? posts.slice(0, limit) : posts;
---

<h2 class="mb-8 font-mono text-sm uppercase tracking-[0.2em] text-base-content/60">
	{listTitle}
</h2>
<div class="grid gap-4">
	{visiblePosts.map((post) => <ArticleCard post={post} />)}
</div>
