---
import HeroContent from "./HeroContent.astro";

const { fullName, title, institute } = Astro.props;
---

<div
  class="relative w-full flex items-center overflow-hidden bg-base-200/30 p-2 lg:p-4"
>
  <div class="items-center w-full">
    <div class="relative">
      <HeroContent
        fullName={fullName}
        title={title}
        institute={institute}
      />
    </div>
  </div>
</div>
