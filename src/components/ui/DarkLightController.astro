---
// DarkLightController.astro
// Binary toggle for Cupcake (Day) vs Dark (Night) themes.
---

<label class="relative inline-flex items-center cursor-pointer select-none transform hover:scale-105 transition-transform duration-300" aria-label="Toggle Theme" transition:persist>
  <input type="checkbox" value="dark" class="theme-controller sr-only" />
  
  <div class="track w-14 h-7 bg-sky-400 rounded-full shadow-inner relative flex items-center transition-colors duration-500 overflow-hidden border border-slate-200/20">
    
    <!-- Night Mode Elements (Stars) -->
    <div class="stars absolute inset-0 opacity-0 transition-opacity duration-500 pointer-events-none">
       <div class="star absolute top-1.5 left-7 w-0.5 h-0.5 bg-white rounded-full opacity-90 animate-pulse"></div>
       <div class="star absolute bottom-2 left-4 w-1 h-1 bg-white rounded-full opacity-80"></div>
       <div class="star absolute top-3 left-3 w-0.5 h-0.5 bg-white rounded-full opacity-70"></div>
    </div>

    <!-- Day Mode Elements (Clouds) -->
    <div class="clouds absolute inset-0 opacity-100 transition-opacity duration-500 pointer-events-none">
       <div class="cloud absolute top-3 right-2 w-4 h-1.5 bg-white/80 rounded-full"></div>
       <div class="cloud absolute bottom-1 right-5 w-3 h-1.5 bg-white/60 rounded-full"></div>
    </div>

    <!-- The Orb (Sun/Moon) -->
    <div class="orb w-5 h-5 bg-yellow-300 rounded-full shadow-[0_0_8px_rgba(253,224,71,0.6)] transform translate-x-1 transition-all duration-500 z-10 relative flex items-center justify-center">
        <!-- Moon Craters -->
        <div class="craters opacity-0 transition-opacity duration-300 absolute inset-0 pointer-events-none">
            <span class="absolute top-1 right-1.5 w-1 h-1 bg-slate-300/50 rounded-full"></span>
            <span class="absolute bottom-1.5 left-1.5 w-1.5 h-1.5 bg-slate-300/50 rounded-full"></span>
        </div>
    </div>

  </div>
</label>

<style>
  /* Checked State (Dark/Night) */
  .theme-controller:checked ~ .track {
    background-color: #0f172a; /* Slate 900 */
    border-color: #1e293b; /* Slate 800 */
  }

  .theme-controller:checked ~ .track .stars {
    opacity: 1;
  }

  .theme-controller:checked ~ .track .clouds {
    opacity: 0;
  }

  .theme-controller:checked ~ .track .orb {
    transform: translateX(28px); /* Move to the right */
    background-color: #f1f5f9; /* Slate 100 (Moon color) */
    box-shadow: 0 0 8px rgba(241, 245, 249, 0.4);
  }

  .theme-controller:checked ~ .track .orb .craters {
    opacity: 1;
  }
</style>

<script is:inline>
  function setupThemeController() {
    const controller = document.querySelector('.theme-controller');
    
    // 1. Init: Set checkbox state based on current theme
    const currentTheme = localStorage.getItem('theme') || 'cupcake';
    if (currentTheme === 'dark') {
      controller.checked = true;
    } else {
      controller.checked = false;
    }

    // 2. Handle Change
    controller.addEventListener('change', (e) => {
      const isDark = e.target.checked;
      const newTheme = isDark ? 'dark' : 'cupcake';
      
      // Update HTML attribute
      document.documentElement.setAttribute('data-theme', newTheme);
      
      // Save to localStorage
      localStorage.setItem('theme', newTheme);
    });
  }

  // Run on load
  setupThemeController();
  
  // Re-run on view transitions
  document.addEventListener('astro:after-swap', setupThemeController);
</script>
