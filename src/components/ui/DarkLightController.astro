---
// Minimal theme toggle: terminal-light (day) vs terminal (night)
---

<label
	class="cursor-pointer select-none font-mono text-xs uppercase tracking-widest text-base-content/60 hover:text-secondary transition-colors"
	aria-label="Toggle theme"
>
	<input type="checkbox" value="terminal" class="theme-controller sr-only" />
	<span class="theme-label-light">Light</span>
	<span class="mx-1 text-base-content/30">/</span>
	<span class="theme-label-dark">Dark</span>
</label>

<style>
	.theme-controller:not(:checked) ~ .theme-label-light {
		@apply text-secondary font-semibold;
	}

	.theme-controller:checked ~ .theme-label-dark {
		@apply text-secondary font-semibold;
	}
</style>

<script is:inline>
	function setupThemeController() {
		const controllers = document.querySelectorAll(".theme-controller");
		if (!controllers.length) return;

		const currentTheme = localStorage.getItem("theme") || "terminal";
		const isDark = currentTheme === "terminal";

		controllers.forEach((controller) => {
			controller.checked = isDark;
			controller.addEventListener("change", (e) => {
				const checked = e.target.checked;
				const newTheme = checked ? "terminal" : "terminal-light";
				document.documentElement.setAttribute("data-theme", newTheme);
				localStorage.setItem("theme", newTheme);
				
				controllers.forEach((c) => {
					if (c !== e.target) c.checked = checked;
				});
			});
		});
	}

	setupThemeController();
	document.addEventListener("astro:after-swap", setupThemeController);
</script>
