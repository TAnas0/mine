---
interface Props {
  delay?: number; // in seconds
  duration?: number; // in seconds
  className?: string;
}

const { delay = 0, duration = 0.5, className = "" } = Astro.props;
---

<div 
  class={`animate-fade-in-up ${className}`} 
  style={`animation-delay: ${delay}s; animation-duration: ${duration}s;`}
>
  <slot />
</div>

<style>
  .animate-fade-in-up {
    opacity: 0;
    transform: translateY(20px);
    animation-name: fadeInUp;
    animation-fill-mode: forwards;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1); /* easeOutExpo */
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
