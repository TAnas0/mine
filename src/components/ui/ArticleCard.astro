---
import type { ArticlePreview } from "@/lib/blog";
import ArticleTag from "./ArticleTag.astro";

interface Props {
	post: ArticlePreview;
}

const { post } = Astro.props;
const { title, date, tags, excerpt, slug, readingTime } = post;
---

<article
	class="group relative border border-base-content/10 bg-white p-5 transition-all duration-200 hover:border-secondary/40 hover:shadow-md sm:p-6 [html[data-theme=terminal]_&]:bg-black [html[data-theme=terminal]_&]:hover:border-secondary/40"
>
	<header
		class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between"
	>
		<h3 class="font-mono text-base leading-snug sm:text-lg flex items-center gap-2 flex-wrap">
			<a
				href={slug}
				class="text-base-content underline-offset-4 hover:text-secondary group-hover:text-secondary transition-colors"
			>
				<span class="absolute inset-0" aria-hidden="true"></span>
				{title}
			</a>
			{post.draft && (
				<span class="relative z-10 rounded border border-warning/40 bg-warning/10 px-1.5 py-0.5 font-mono text-[10px] font-semibold text-warning uppercase">
					Draft
				</span>
			)}
		</h3>
		<div class="shrink-0 flex items-center gap-1.5 font-mono text-xs text-base-content/50">
			<time datetime={date}>
				{new Date(date).toLocaleDateString("en-US", {
					year: "numeric",
					month: "short",
					day: "numeric",
				})}
			</time>
			{readingTime && (
				<>
					<span class="text-base-content/30">·</span>
					<span>{readingTime}</span>
				</>
			)}
		</div>
	</header>

	{
		tags.length > 0 && (
			<ul class="relative z-10 mt-3 flex flex-wrap gap-2" aria-label="Tags">
				{tags.map((tag) => (
					<li>
						<ArticleTag tag={tag} />
					</li>
				))}
			</ul>
		)
	}

	<p class="mt-4 font-mono text-sm leading-relaxed text-base-content/70">
		{excerpt}
	</p>

	<div class="mt-5 flex items-center justify-end">
		<span class="inline-flex items-center gap-1 font-mono text-xs uppercase tracking-wide text-secondary group-hover:translate-x-1 transition-transform">
			Read <span aria-hidden="true">→</span>
		</span>
	</div>
</article>
