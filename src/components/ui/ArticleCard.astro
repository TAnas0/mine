---
import type { ArticlePreview } from "@/lib/blog";
import ArticleTag from "./ArticleTag.astro";

interface Props {
	post: ArticlePreview;
}

const { post } = Astro.props;
const { title, date, tags, excerpt, slug } = post;
---

<article
	class="group border border-base-content/10 bg-base-200/20 p-5 transition-colors hover:border-secondary/40 sm:p-6"
>
	<header
		class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"
	>
		<h3 class="font-mono text-base leading-snug sm:text-lg">
			<a
				href={slug}
				class="text-base-content underline-offset-4 hover:text-secondary hover:underline"
			>
				{title}
			</a>
		</h3>
		<time
			datetime={date}
			class="shrink-0 font-mono text-xs text-base-content/50"
		>
			{new Date(date).toLocaleDateString("en-US", {
				year: "numeric",
				month: "short",
				day: "numeric",
			})}
		</time>
	</header>

	{
		tags.length > 0 && (
			<ul class="mt-3 flex flex-wrap gap-2" aria-label="Tags">
				{tags.map((tag) => (
					<li>
						<ArticleTag tag={tag} />
					</li>
				))}
			</ul>
		)
	}

	<p class="mt-4 font-mono text-sm leading-relaxed text-base-content/70">
		{excerpt}
	</p>

	<a
		href={slug}
		class="mt-4 inline-block font-mono text-xs uppercase tracking-wide text-secondary/80 hover:text-secondary"
	>
		Read →
	</a>
</article>
