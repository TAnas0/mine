---
import { template } from "@/settings";
const { page } = Astro.props;
---

<div class="mt-8 flex justify-center gap-2">
	<a
		href={page.url.prev ?? "#"}
		class:list={[
			"border border-base-content/10 px-3 py-1 font-mono text-xs uppercase tracking-wide text-base-content/60 hover:border-secondary/40 hover:text-secondary",
			{ "pointer-events-none opacity-30": !page.url.prev },
		]}
	>
		← Prev
	</a>
	<a
		href={page.url.next ?? "#"}
		class:list={[
			"border border-base-content/10 px-3 py-1 font-mono text-xs uppercase tracking-wide text-base-content/60 hover:border-secondary/40 hover:text-secondary",
			{ "pointer-events-none opacity-30": !page.url.next },
		]}
	>
		Next →
	</a>
</div>
