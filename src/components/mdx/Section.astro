---
interface Props {
    title?: string;
}

const { title = "Scope" } = Astro.props;
---
<div class="my-8 rounded-xl border-l-4 border-secondary bg-base-200/30 p-6 shadow-sm not-prose">
    {title && (
        <h3 class="mt-0 mb-4 text-xl font-bold tracking-tight text-secondary flex items-center gap-2 font-mono">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5 shrink-0">
                <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 013.5 2h9a1.5 1.5 0 011.5 1.5V16.5h3.25a.75.75 0 010 1.5H3.5a.75.75 0 010-1.5H8V9.5H3.5V3.5zm6 7.5v7h4v-7h-4z" clip-rule="evenodd" />
            </svg>
            <span>{title}</span>
        </h3>
    )}
    <div class="font-mono text-sm leading-relaxed text-base-content/90 space-y-3">
        <slot />
    </div>
</div>
