---
import Layout from "@/layouts/Layout.astro";
import { books, CATEGORY_LABELS, CATEGORY_DESCRIPTIONS } from "@/data/books";
import type { BookCategory } from "@/data/books";
import { template } from "@/settings";

const title = "Bookshelf";
const description =
	"A curated library of evergreen software engineering books — titles that have stood the test of time and shaped how I think about building systems.";

const categoryOrder: BookCategory[] = [
	"craft",
	"architecture",
	"sociotechnical",
	"algorithms",
	"security",
	"philosophy",
];

const grouped = categoryOrder
	.map((cat) => ({
		category: cat,
		label: CATEGORY_LABELS[cat],
		description: CATEGORY_DESCRIPTIONS[cat],
		books: books.filter((b) => b.category === cat),
	}))
	.filter((g) => g.books.length > 0);

const totalRead    = books.filter((b) => b.status === "read").length;
const totalReading = books.filter((b) => b.status === "reading").length;
const totalToRead  = books.filter((b) => b.status === "to-read").length;
const totalBooks   = books.length;

const CATEGORY_ICONS: Record<BookCategory, string> = {
	craft:          "⚒",
	architecture:   "🏛",
	sociotechnical: "🤝",
	algorithms:     "∑",
	security:       "🔐",
	philosophy:     "🔭",
};

function initials(title: string): string {
	return title
		.split(/\s+/)
		.filter((w) => w.length > 2 && !/^(the|a|an|of|&|and|in|for)$/i.test(w))
		.slice(0, 2)
		.map((w) => w[0].toUpperCase())
		.join("");
}

function darken(hex: string): string {
	// parse and darken by ~30%
	const r = parseInt(hex.slice(1, 3), 16);
	const g = parseInt(hex.slice(3, 5), 16);
	const b = parseInt(hex.slice(5, 7), 16);
	return `rgb(${Math.round(r * 0.55)},${Math.round(g * 0.55)},${Math.round(b * 0.55)})`;
}

function lighten(hex: string): string {
	const r = parseInt(hex.slice(1, 3), 16);
	const g = parseInt(hex.slice(3, 5), 16);
	const b = parseInt(hex.slice(5, 7), 16);
	return `rgba(${Math.min(255,r+80)},${Math.min(255,g+80)},${Math.min(255,b+80)},0.25)`;
}
---

<Layout title={`Bookshelf · ${title}`} description={description}>
	<div class="w-full">

		<!-- ── Header ────────────────────────────────────────────────── -->
		<header class="mb-12 border-b border-base-content/15 pb-10">
			<div class="flex items-start gap-3 mb-3">
				<span class="font-mono text-secondary text-2xl font-bold" aria-hidden="true">#</span>
				<h1 class="font-mono text-3xl font-bold tracking-tight text-base-content uppercase">
					Bookshelf
				</h1>
			</div>
			<p class="font-mono text-sm leading-relaxed text-base-content/60 max-w-2xl mb-6">
				Evergreen titles that have shaped how I think about building software — 
				books that focus on things that don't expire: structural trade-offs, managing complexity, 
				human dynamics. Not the shiny new releases; the ones still being read decades later.
			</p>

			<!-- Stats -->
			<div class="flex flex-wrap gap-3">
				<div class="border border-base-content/10 bg-base-200/30 px-4 py-2.5 min-w-[5rem]">
					<span class="font-mono text-[10px] uppercase tracking-widest text-base-content/40 block">Total</span>
					<span class="font-mono text-xl font-bold text-base-content">{totalBooks}</span>
				</div>
				<div class="border border-success/25 bg-success/5 px-4 py-2.5 min-w-[5rem]">
					<span class="font-mono text-[10px] uppercase tracking-widest text-success/60 block">Read</span>
					<span class="font-mono text-xl font-bold text-success">{totalRead}</span>
				</div>
				{totalReading > 0 && (
					<div class="border border-info/25 bg-info/5 px-4 py-2.5 min-w-[5rem]">
						<span class="font-mono text-[10px] uppercase tracking-widest text-info/60 block">Reading</span>
						<span class="font-mono text-xl font-bold text-info">{totalReading}</span>
					</div>
				)}
				<div class="border border-base-content/10 bg-base-200/30 px-4 py-2.5 min-w-[5rem]">
					<span class="font-mono text-[10px] uppercase tracking-widest text-base-content/40 block">To Read</span>
					<span class="font-mono text-xl font-bold text-base-content/70">{totalToRead}</span>
				</div>
			</div>
		</header>

		<!-- ── Shelves ───────────────────────────────────────────────── -->
		{grouped.map((group) => (
			<section class="mb-16">
				<!-- Shelf label -->
				<div class="mb-5 flex items-center gap-3">
					<span class="text-lg shrink-0" aria-hidden="true">{CATEGORY_ICONS[group.category as BookCategory]}</span>
					<div class="flex-1 min-w-0">
						<h2 class="font-mono text-sm font-bold tracking-widest text-base-content uppercase">
							{group.label}
						</h2>
						<p class="font-mono text-[10px] tracking-wide text-base-content/40 uppercase mt-0.5">
							{group.description}
						</p>
					</div>
					<span class="font-mono text-xs text-base-content/30 shrink-0">
						{group.books.filter(b => b.status === "read").length}/{group.books.length}
					</span>
				</div>

				<!-- Book cards — grid shelf -->
				<div class="shelf-surface relative">
					<!-- Wood plank surface -->
					<div class="shelf-plank" aria-hidden="true"></div>

					<!-- Books row -->
					<div class="books-row flex flex-wrap gap-3 pb-4 pt-2 px-2">
						{group.books.map((book, i) => {
							const color = book.coverColor ?? "#2b4a8c";
							const dark  = darken(color);
							const glow  = lighten(color);
							const abbr  = initials(book.title);
							const isToRead = book.status === "to-read";
							const isReading = book.status === "reading";
							return (
								<div
									class={`book-card group relative cursor-pointer select-none ${isToRead ? "opacity-60 hover:opacity-90" : ""}`}
									data-book-index={i}
									data-category={group.category}
									aria-label={`${book.title} by ${book.author}`}
									tabindex="0"
									role="button"
								>
									{/* ── Cover ── */}
									<div
										class="book-cover relative overflow-hidden"
										style={`
											background: linear-gradient(160deg, ${color} 0%, ${dark} 100%);
											box-shadow: -3px 3px 8px rgba(0,0,0,0.5), inset -2px 0 6px rgba(0,0,0,0.3);
										`}
									>
										{book.coverImage ? (
											<img
												src={book.coverImage.startsWith("http") || (template.base && book.coverImage.startsWith(template.base)) ? book.coverImage : `${template.base}${book.coverImage.startsWith("/") ? "" : "/"}${book.coverImage}`}
												alt={`Cover of ${book.title}`}
												class="h-full w-full object-cover"
												loading="lazy"
											/>
										) : (
											<>
												{/* Placeholder design */}
												<div
													class="absolute inset-0"
													style={`background: linear-gradient(135deg, transparent 0%, rgba(255,255,255,0.04) 50%, transparent 100%)`}
												/>
												{/* Top accent line */}
												<div
													class="absolute top-0 left-0 right-0 h-0.5"
													style={`background: rgba(255,255,255,0.15)`}
												/>
												{/* Side spine crease */}
												<div
													class="absolute left-[5px] top-0 bottom-0 w-px"
													style={`background: rgba(0,0,0,0.25)`}
												/>
												{/* Abbrev initials */}
												<div class="absolute inset-0 flex flex-col items-center justify-center gap-1 px-2 text-center">
													<span
														class="font-mono font-bold leading-none"
														style={`color: rgba(255,255,255,0.12); font-size: 4rem;`}
													>
														{abbr}
													</span>
												</div>
												{/* Title on spine */}
												<div class="absolute bottom-0 left-0 right-0 px-3 pb-3 pt-8"
													style={`background: linear-gradient(transparent, rgba(0,0,0,0.55))`}
												>
													<p
														class="font-mono font-semibold text-center leading-tight"
														style={`color: rgba(255,255,255,0.85); font-size: 0.72rem; word-break: break-word;`}
													>
														{book.title}
													</p>
												</div>
											</>
										)}

										{/* Status badge */}
										{isToRead && (
											<div class="absolute top-1.5 right-1.5 z-10">
												<span class="block w-1.5 h-1.5 rounded-full bg-base-content/40" title="To read" />
											</div>
										)}
										{isReading && (
											<div class="absolute top-1.5 right-1.5 z-10">
												<span class="block w-1.5 h-1.5 rounded-full bg-info animate-pulse" title="Currently reading" />
											</div>
										)}
									</div>

									{/* ── Tooltip popup on hover ── */}
									<div
										class="book-tooltip absolute bottom-[calc(100%+12px)] left-1/2 -translate-x-1/2 z-50 w-60 opacity-0 pointer-events-none group-hover:opacity-100 group-focus:opacity-100 transition-all duration-200 group-hover:pointer-events-auto group-focus:pointer-events-auto"
										role="tooltip"
									>
										<div
											class="relative rounded-none border border-base-content/20 bg-base-100 shadow-2xl p-4"
											style={`border-top: 2px solid ${color};`}
										>
											{/* Arrow */}
											<div
												class="absolute left-1/2 -translate-x-1/2 -bottom-[7px] w-3 h-3 border-r border-b border-base-content/20 bg-base-100"
												style="transform: translateX(-50%) rotate(45deg);"
											/>

											<p class="font-mono text-xs font-bold text-base-content leading-tight mb-0.5">
												{book.title}
											</p>
											<p class="font-mono text-[10px] text-base-content/50 mb-2">
												{book.author} · {book.year}
											</p>

											{book.rating && (
												<p class="font-mono text-[10px] text-warning/80 mb-2 tracking-tight">
													{"★".repeat(book.rating)}{"☆".repeat(5 - book.rating)}
												</p>
											)}

											<p class="font-mono text-[11px] text-base-content/70 leading-relaxed mb-2">
												{book.description}
											</p>

											{book.note && (
												<p class="font-mono text-[10px] text-secondary/80 italic leading-relaxed border-l border-secondary/30 pl-2">
													{book.note}
												</p>
											)}

											<div class="mt-2.5 flex items-center justify-between">
												<span
													class={`font-mono text-[9px] uppercase tracking-widest px-1.5 py-0.5 ${
														book.status === "read"
															? "bg-success/15 text-success"
															: book.status === "reading"
																? "bg-info/15 text-info"
																: "bg-base-content/10 text-base-content/40"
													}`}
												>
													{book.status === "to-read" ? "To read" : book.status}
												</span>
												{book.url && (
													<a
														href={book.url}
														target="_blank"
														rel="noopener noreferrer"
														class="font-mono text-[9px] uppercase tracking-widest text-secondary hover:underline"
													>
														Info ↗
													</a>
												)}
											</div>
										</div>
									</div>
								</div>
							);
						})}
					</div>
				</div>
			</section>
		))}

		<!-- Footer note -->
		<footer class="border-t border-base-content/10 pt-8 mt-4">
			<p class="font-mono text-xs text-base-content/35 leading-relaxed">
				Living list — updated as I read and discover. Ratings reflect personal engineering value. 
				Cover images coming soon.
			</p>
		</footer>
	</div>
</Layout>

<style>
	/* ── Book card base ─────────────────────────────────────────── */
	.book-card {
		position: relative;
		transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
		z-index: 1;
	}

	.book-card:hover,
	.book-card:focus {
		transform: translateY(-12px) scale(1.05);
		outline: none;
		z-index: 30;
	}

	.book-cover {
		width: 150px;
		height: 225px;
		border-radius: 1px 4px 4px 1px;
		position: relative;
	}

	@media (min-width: 640px) {
		.book-cover {
			width: 165px;
			height: 248px;
		}
	}

	/* ── Shelf surface ─────────────────────────────────────────── */
	.shelf-surface {
		border-radius: 2px;
		overflow: visible;
	}

	.books-row {
		overflow: visible;
		position: relative;
		border-bottom: 4px solid oklch(var(--b3, 0.88 0 0) / 0.7);
		box-shadow: 0 4px 0 oklch(var(--b3, 0.88 0 0) / 0.35);
	}

	/* Dark theme shelf plank */
	:global([data-theme="terminal"]) .books-row {
		border-bottom-color: rgba(255,255,255,0.10);
		box-shadow: 0 4px 0 rgba(255,255,255,0.04);
	}

	/* ── Tooltip positioning edge clamp ────────────────────────── */
	/* Keep tooltips within viewport on first/last items */
	.book-card:first-child .book-tooltip,
	.book-card:nth-child(2) .book-tooltip {
		left: 0;
		transform: none;
	}
	.book-card:first-child .book-tooltip .absolute,
	.book-card:nth-child(2) .book-tooltip .absolute {
		left: 20px;
		transform: translateX(0) rotate(45deg);
	}

	/* ── Tooltip always on top ─────────────────────────────────── */
	.book-tooltip {
		filter: drop-shadow(0 8px 24px rgba(0,0,0,0.35));
	}
</style>
