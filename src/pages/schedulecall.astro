---
import Layout from "../layouts/Layout.astro";
import MotionWrapper from "../components/ui/MotionWrapper.astro";
---

<Layout title="Schedule Call">
  <div class="max-w-2xl mx-auto py-8 text-center">
    <MotionWrapper delay={0.1} duration={0.6}>
      <h1 class="text-4xl font-extrabold mb-4 bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
        Let's Chat
      </h1>
      <p class="text-base-content/70 text-lg mb-8 leading-relaxed">
        I'm always open to discussing new opportunities, systems design, or interesting engineering problems.
      </p>
    </MotionWrapper>

    <MotionWrapper delay={0.2} duration={0.6}>
      <div class="bg-base-200/30 border border-base-300/50 p-8 rounded-2xl shadow-xl flex flex-col items-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-20 stroke-primary mb-6 animate-pulse" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z" />
        </svg>

        <p class="text-base-content/85 text-lg mb-6">
          Please drop me a quick message via the contact form to share what you'd like to chat about and your availability. I'll get back to you with a direct calendar link!
        </p>

        <a href="/contact" class="btn btn-primary btn-wide text-lg shadow-lg hover:shadow-primary/20">
          Go to Contact Form
        </a>
      </div>
    </MotionWrapper>
  </div>
</Layout>
