---
import Layout from "../layouts/Layout.astro";
import { template } from "@/settings";
---

<script is:inline>
  window.location.replace(`${window.location.pathname.replace(/\/schedulecall\/?$/, "")}/contact#schedule`);
</script>

<Layout title="Schedule Call">
  <div class="py-16 text-center font-mono max-w-md mx-auto">
    <p class="text-base-content/70 text-sm mb-4">Redirecting to contact & scheduling page...</p>
    <a href={`${template.base}/contact#schedule`} class="btn btn-secondary text-secondary-content font-mono text-xs uppercase tracking-wider">
      Click here if not redirected →
    </a>
  </div>
</Layout>
