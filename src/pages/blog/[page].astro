---
import ArticleList from "@/components/ui/ArticleList.astro";
import Layout from "@/layouts/Layout.astro";
import { blogPostToPreview, sortPostsByDate, filterPublishedPosts } from "@/lib/blog";
import { template } from "@/settings";
import { getCollection } from "astro:content";

export async function getStaticPaths({ paginate }) {
	const blogEntries = filterPublishedPosts(await getCollection("blog"));
	const posts = sortPostsByDate(blogEntries.map(blogPostToPreview));

	return paginate(posts, {
		pageSize: template.postPerPage,
	});
}
---

<Layout title="Articles">
	<ArticleList listTitle="Articles" pageSize={template.postPerPage} />
</Layout>
