---
import Layout from "@/layouts/Layout.astro";
import { template } from "@/settings";

const targetUrl = `${template.base}/blog/1`;
---

<meta http-equiv="refresh" content={`0;url=${targetUrl}`} />

<script is:inline define:vars={{ targetUrl }}>
  const search = window.location.search || "";
  const hash = window.location.hash || "";
  window.location.replace(`${targetUrl}${search}${hash}`);
</script>

<Layout title="Articles">
  <div class="py-16 text-center font-mono max-w-md mx-auto">
    <p class="text-base-content/70 text-sm mb-4">Redirecting to articles...</p>
    <a
      href={targetUrl}
      class="btn btn-secondary text-secondary-content font-mono text-xs uppercase tracking-wider"
    >
      Click here if not redirected →
    </a>
  </div>
</Layout>

