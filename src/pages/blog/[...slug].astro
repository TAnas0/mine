---
import Layout from "@/layouts/Layout.astro";
import Prose from "@/components/ui/Prose.astro";
import ArticleTag from "@/components/ui/ArticleTag.astro";
import TableOfContents from "@/components/blog/TableOfContents.astro";
import { getCollection, render } from "astro:content";
import { filterPublishedPosts, calculateReadingTime } from "@/lib/blog";

export async function getStaticPaths() {
	const blogEntries = filterPublishedPosts(await getCollection("blog"));

	const posts = blogEntries.map((post) => {
		const slug = post.id.replace(/\.[^/.]+$/, "");
		return {
			params: { slug },
			props: { post },
		};
	});
	return posts;
}

const { post } = Astro.props;
const { title, date, lastModified, tags, excerpt, subtitle } = post.data;

const { headings } = await render(post);
const { Content } = await render(post);
---

<Layout title={title} description={excerpt || ''} contentWidth="reading">
	<article class="w-full">
		<header
			class="mx-auto mb-10 max-w-4xl border-b border-base-content/10 pb-8 text-center lg:mb-14"
		>
			<h1
				class="mb-4 text-3xl font-bold tracking-tight text-base-content lg:text-4xl xl:text-5xl"
			>
				{title}
			</h1>
			{
				(subtitle || excerpt) && (
					<p class="mx-auto mb-6 max-w-2xl font-mono text-base text-base-content/70 sm:text-lg leading-relaxed">
						{subtitle || excerpt}
					</p>
				)
			}
			<div
				class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm text-base-content/60"
			>
				{
					tags && (
						<ul
							class="flex flex-wrap justify-center gap-2"
							aria-label="Tags"
						>
							{tags.map((tag) => (
								<li>
									<ArticleTag tag={tag} />
								</li>
							))}
						</ul>
					)
				}
				{
					tags && tags.length > 0 && (
						<span class="hidden sm:inline">·</span>
					)
				}
				<span class="font-mono">
					Published <time datetime={date}>
						{new Date(date).toLocaleDateString("en-US", {
							year: "numeric",
							month: "long",
							day: "numeric",
						})}
					</time>
				</span>
				{
					lastModified && lastModified !== date && (
						<>
							<span class="hidden sm:inline">·</span>
							<span class="inline-flex items-center gap-1.5 font-mono text-secondary">
								<svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 stroke-current opacity-70" fill="none" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
								</svg>
								<span>Updated <time datetime={lastModified}>{new Date(lastModified).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time></span>
							</span>
						</>
					)
				}
				<span class="hidden sm:inline">·</span>
				<span class="inline-flex items-center gap-1.5 font-mono">
					<svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 stroke-current opacity-70" fill="none" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
						<circle cx="12" cy="12" r="10"></circle>
						<polyline points="12 6 12 12 16 14"></polyline>
					</svg>
					<span>{calculateReadingTime(post.body)}</span>
				</span>
			</div>
		</header>

		<div
			class="mx-auto grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_16rem] xl:grid-cols-[minmax(0,1fr)_18rem] lg:gap-x-12 xl:gap-x-16"
		>
			<div class="min-w-0 w-full">
				<div class="mb-8 lg:hidden">
					<details class="collapse collapse-arrow border border-base-content/10 bg-base-200/40">
						<summary class="collapse-title font-mono text-sm uppercase tracking-wide">
							Contents
						</summary>
						<div class="collapse-content">
							<TableOfContents headings={headings} />
						</div>
					</details>
				</div>

				<Prose>
					<Content />
				</Prose>
			</div>

			<aside class="hidden lg:block w-full" aria-label="Table of contents">
				<div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto pr-2">
					<TableOfContents headings={headings} />
				</div>
			</aside>
		</div>
	</article>
</Layout>
