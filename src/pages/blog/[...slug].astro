---
import Layout from "@/layouts/Layout.astro";
import Prose from "@/components/ui/Prose.astro";
import ArticleTag from "@/components/ui/ArticleTag.astro";
import TableOfContents from "@/components/blog/TableOfContents.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const blogEntries = await getCollection("blog");

	const posts = blogEntries.map((post) => {
		const slug = post.id.replace(/\.[^/.]+$/, "");
		return {
			params: { slug },
			props: { post },
		};
	});
	return posts;
}

const { post } = Astro.props;
const { title, date, tags } = post.data;

const { headings } = await render(post);
const { Content } = await render(post);
---

<Layout title={title} contentWidth="reading">
	<article>
		<header
			class="mx-auto mb-10 max-w-measure border-b border-base-content/10 pb-8 text-center lg:mb-14"
		>
			<h1
				class="mb-4 text-3xl font-bold tracking-tight text-base-content lg:text-4xl"
			>
				{title}
			</h1>
			<div
				class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm text-base-content/60"
			>
				{
					tags && (
						<ul
							class="flex flex-wrap justify-center gap-2"
							aria-label="Tags"
						>
							{tags.map((tag) => (
								<li>
									<ArticleTag tag={tag} />
								</li>
							))}
						</ul>
					)
				}
				{
					tags && tags.length > 0 && (
						<span class="hidden sm:inline">·</span>
					)
				}
				<time datetime={date} class="font-mono">
					{new Date(date).toLocaleDateString("en-US", {
						year: "numeric",
						month: "long",
						day: "numeric",
					})}
				</time>
			</div>
		</header>

		<div
			class="mx-auto grid max-w-measure grid-cols-1 gap-12 lg:max-w-none lg:grid-cols-[minmax(0,52rem)_11rem] lg:justify-center lg:gap-x-16"
		>
			<div class="min-w-0">
				<div class="mb-8 lg:hidden">
					<details class="collapse collapse-arrow border border-base-content/10 bg-base-200/40">
						<summary class="collapse-title font-mono text-sm uppercase tracking-wide">
							Contents
						</summary>
						<div class="collapse-content">
							<TableOfContents headings={headings} />
						</div>
					</details>
				</div>

				<Prose>
					<Content />
				</Prose>
			</div>

			<aside class="hidden lg:block">
				<div class="sticky top-24">
					<TableOfContents headings={headings} />
				</div>
			</aside>
		</div>
	</article>
</Layout>
