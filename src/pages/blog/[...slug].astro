---
import Layout from "@/layouts/Layout.astro";
import Prose from "@/components/ui/Prose.astro";
import ArticleTag from "@/components/ui/ArticleTag.astro";
import TableOfContents from "@/components/blog/TableOfContents.astro";
import { getCollection, render } from "astro:content";
import { filterPublishedPosts } from "@/lib/blog";

export async function getStaticPaths() {
	const blogEntries = filterPublishedPosts(await getCollection("blog"));

	const posts = blogEntries.map((post) => {
		const slug = post.id.replace(/\.[^/.]+$/, "");
		return {
			params: { slug },
			props: { post },
		};
	});
	return posts;
}

const { post } = Astro.props;
const { title, date, tags } = post.data;

const { headings } = await render(post);
const { Content } = await render(post);
---

<Layout title={title} contentWidth="reading">
	<article>
		<header
			class="mx-auto mb-10 max-w-4xl border-b border-base-content/10 pb-8 text-center lg:mb-14"
		>
			<h1
				class="mb-4 text-3xl font-bold tracking-tight text-base-content lg:text-4xl xl:text-5xl"
			>
				{title}
			</h1>
			<div
				class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm text-base-content/60"
			>
				{
					tags && (
						<ul
							class="flex flex-wrap justify-center gap-2"
							aria-label="Tags"
						>
							{tags.map((tag) => (
								<li>
									<ArticleTag tag={tag} />
								</li>
							))}
						</ul>
					)
				}
				{
					tags && tags.length > 0 && (
						<span class="hidden sm:inline">·</span>
					)
				}
				<time datetime={date} class="font-mono">
					{new Date(date).toLocaleDateString("en-US", {
						year: "numeric",
						month: "long",
						day: "numeric",
					})}
				</time>
			</div>
		</header>

		<div
			class="mx-auto grid grid-cols-1 gap-10 lg:grid-cols-[16rem_minmax(0,52rem)] xl:grid-cols-[18rem_minmax(0,56rem)] lg:justify-start lg:gap-x-12 xl:gap-x-16"
		>
			<aside class="hidden lg:block w-full">
				<div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto pr-2">
					<TableOfContents headings={headings} />
				</div>
			</aside>

			<div class="min-w-0 w-full">
				<div class="mb-8 lg:hidden">
					<details class="collapse collapse-arrow border border-base-content/10 bg-base-200/40">
						<summary class="collapse-title font-mono text-sm uppercase tracking-wide">
							Contents
						</summary>
						<div class="collapse-content">
							<TableOfContents headings={headings} />
						</div>
					</details>
				</div>

				<Prose>
					<Content />
				</Prose>
			</div>
		</div>
	</article>
</Layout>
