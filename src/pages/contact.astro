---
import Layout from "../layouts/Layout.astro";
import MotionWrapper from "../components/ui/MotionWrapper.astro";
import { social } from "@/settings";

const calendlyUrl = social.calendly || "https://calendly.com/lexianowl/30min";
const formspreeUrl = "https://formspree.io/f/xvkkvlgq";
---

<Layout title="Contact & Schedule a Call" contentWidth="reading">
  <div class="py-6 sm:py-10 max-w-6xl mx-auto">
    <MotionWrapper delay={0.1} duration={0.6}>
      <div class="mb-10 text-center max-w-xl mx-auto">
        <h1 class="text-3xl sm:text-4xl font-mono font-bold tracking-tight mb-3 text-base-content">
          Get In Touch<span class="text-secondary">.</span>
        </h1>
        <p class="text-base-content/70 font-mono text-sm leading-relaxed">
          Send a direct message or schedule a 1-on-1 engineering call via Calendly.
        </p>
      </div>
    </MotionWrapper>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
      <!-- Option A: Direct Message Form -->
      <MotionWrapper delay={0.2} duration={0.6} className="h-full flex flex-col">
        <div class="bg-base-200/40 border border-base-content/10 p-6 sm:p-8 rounded-xl shadow-lg flex flex-col justify-between h-full">
          <div>
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-base-content/10">
              <div class="flex items-center gap-3">
                <div class="p-2.5 rounded-lg bg-secondary/10 text-secondary">
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                  </svg>
                </div>
                <div>
                  <h2 class="font-mono text-base font-bold text-base-content">Leave a Message</h2>
                  <p class="font-mono text-xs text-base-content/60">For inquiries, feedback & general notes</p>
                </div>
              </div>
              <span class="font-mono text-[10px] uppercase tracking-wider px-2 py-0.5 rounded border border-base-content/10 bg-base-100 text-base-content/60">Async</span>
            </div>

            <form 
              id="contact-form"
              action={formspreeUrl}
              method="POST"
              class="space-y-4"
            >
              <div>
                <label class="label font-mono text-xs uppercase tracking-wider text-base-content/70">Name</label>
                <input 
                  type="text" 
                  name="name"
                  placeholder="Your name" 
                  class="input input-bordered w-full font-mono text-sm focus:border-secondary focus:ring-1 focus:ring-secondary focus:outline-none bg-base-100/70" 
                  required 
                />
              </div>

              <div>
                <label class="label font-mono text-xs uppercase tracking-wider text-base-content/70">Email Address</label>
                <input 
                  type="email" 
                  name="email"
                  placeholder="your.email@example.com" 
                  class="input input-bordered w-full font-mono text-sm focus:border-secondary focus:ring-1 focus:ring-secondary focus:outline-none bg-base-100/70" 
                  required 
                />
              </div>

              <div>
                <label class="label font-mono text-xs uppercase tracking-wider text-base-content/70">Message</label>
                <textarea 
                  name="message"
                  placeholder="Tell me about your project, system architecture, or questions..." 
                  class="textarea textarea-bordered w-full h-36 font-mono text-sm focus:border-secondary focus:ring-1 focus:ring-secondary focus:outline-none bg-base-100/70" 
                  required
                ></textarea>
              </div>

              <!-- Form Status Feedback -->
              <div id="form-status" class="hidden font-mono text-xs px-3 py-2.5 rounded"></div>

              <div class="pt-2">
                <button 
                  id="submit-btn"
                  type="submit" 
                  class="btn btn-secondary w-full font-mono text-xs uppercase tracking-widest text-secondary-content shadow-md"
                >
                  Send Message →
                </button>
                <p class="font-mono text-[11px] text-base-content/50 text-center mt-3">
                  Usually replies within 24–48 hours.
                </p>
              </div>
            </form>
          </div>
        </div>
      </MotionWrapper>

      <!-- Option B: Schedule a Call via Calendly -->
      <MotionWrapper delay={0.3} duration={0.6} className="h-full flex flex-col">
        <div id="schedule" class="bg-base-200/40 border border-base-content/10 p-6 sm:p-8 rounded-xl shadow-lg flex flex-col justify-between h-full">
          <div>
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-base-content/10">
              <div class="flex items-center gap-3">
                <div class="p-2.5 rounded-lg bg-secondary/10 text-secondary">
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                  </svg>
                </div>
                <div>
                  <h2 class="font-mono text-base font-bold text-base-content">Schedule a 1-on-1 Call</h2>
                  <p class="font-mono text-xs text-base-content/60">30 min video meeting via Calendly</p>
                </div>
              </div>
              <span class="font-mono text-[10px] uppercase tracking-wider px-2 py-0.5 rounded border border-secondary/30 bg-secondary/10 text-secondary font-semibold">Live</span>
            </div>

            <!-- Call Info & Highlights -->
            <div class="space-y-4 my-2">
              <div class="grid grid-cols-2 gap-3">
                <div class="p-3 rounded-lg border border-base-content/10 bg-base-100/60">
                  <span class="font-mono text-[10px] uppercase tracking-wider text-base-content/50 block">Duration</span>
                  <span class="font-mono text-sm font-bold text-base-content">30 Minutes</span>
                </div>
                <div class="p-3 rounded-lg border border-base-content/10 bg-base-100/60">
                  <span class="font-mono text-[10px] uppercase tracking-wider text-base-content/50 block">Format</span>
                  <span class="font-mono text-sm font-bold text-base-content">Google Meet</span>
                </div>
              </div>

              <div class="p-4 rounded-lg border border-base-content/10 bg-base-100/60 space-y-2">
                <span class="font-mono text-xs uppercase tracking-wider text-secondary font-semibold block">Topics & Focus Areas</span>
                <ul class="font-mono text-xs text-base-content/75 space-y-1.5 list-none p-0 m-0">
                  <li class="flex items-start gap-2">
                    <span class="text-secondary font-bold">›</span>
                    <span>Backend & systems architecture review</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-secondary font-bold">›</span>
                    <span>DevOps, CI/CD pipelines & cloud infra</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-secondary font-bold">›</span>
                    <span>Performance, scaling & security audits</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-secondary font-bold">›</span>
                    <span>Technical consulting & project collaboration</span>
                  </li>
                </ul>
              </div>

            </div>
          </div>

          <!-- Bottom CTA Action (Aligned with Left Card's Submit Button) -->
          <div class="pt-4">
            <a
              href={calendlyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary w-full font-mono text-xs uppercase tracking-widest text-secondary-content shadow-md flex items-center justify-center gap-2"
            >
              <span>Book on Calendly →</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
            </a>
            <p class="font-mono text-[11px] text-base-content/50 text-center mt-3">
              Opens live calendar in a new tab.
            </p>
          </div>
        </div>
      </MotionWrapper>
    </div>
  </div>

  <script is:inline>
    function setupContactForm() {
      const form = document.getElementById("contact-form");
      const status = document.getElementById("form-status");
      const btn = document.getElementById("submit-btn");
      if (!form || !status || !btn) return;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const originalText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = "Sending...";
        status.className = "hidden";

        try {
          const response = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            headers: { Accept: "application/json" }
          });

          if (response.ok) {
            form.reset();
            status.textContent = "✓ Message sent successfully! I'll get back to you soon.";
            status.className = "font-mono text-xs px-3 py-2.5 rounded bg-success/15 text-success border border-success/30";
          } else {
            const data = await response.json().catch(() => ({}));
            status.textContent = data.errors ? data.errors.map(err => err.message).join(", ") : "Oops! There was a problem submitting your form.";
            status.className = "font-mono text-xs px-3 py-2.5 rounded bg-error/15 text-error border border-error/30";
          }
        } catch (err) {
          status.textContent = "Network error. Please try again or check your connection.";
          status.className = "font-mono text-xs px-3 py-2.5 rounded bg-error/15 text-error border border-error/30";
        } finally {
          btn.disabled = false;
          btn.innerHTML = originalText;
        }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupContactForm);
    } else {
      setupContactForm();
    }
    document.addEventListener("astro:after-swap", setupContactForm);
  </script>
</Layout>
