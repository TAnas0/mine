---
import BetterIcon from "../components/ui/BetterIcon.astro";
import DarkLightController from "../components/ui/DarkLightController.astro";
import Navbar from "../components/ui/Navbar.astro";
import Head from "../components/Head.astro";

import { seo, profile, template } from "../settings";
import Footer from "../components/ui/Footer.astro";

type Props = {
	title?: string;
	description?: string;
	image?: string;
	contentWidth?: "default" | "reading";
};

const {
	title = seo.default_title,
	description = seo.default_description,
	image = seo.default_image,
	contentWidth = "default",
} = Astro.props;

const mainWidthClass =
	contentWidth === "reading" ? "max-w-[85rem] px-4 sm:px-6 lg:px-8 xl:px-12" : "max-w-2xl px-6";
---

<!doctype html>
<html lang="en">
	<head>
		<Head title={title} description={description} image={image} />
		<!-- Font Preconnect for Core Web Vitals Optimization -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Font Option 1: Fira Code (Active - Modern Developer Monospace with Ligatures) -->
		<link
			href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>

		<!-- Font Option 2: Plus Jakarta Sans (Alternative - Sleek Modern Tech Sans-Serif) -->
		<!-- <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet" /> -->

		<!-- Font Option 3: Space Mono (Alternative - Distinctive Retro / Cyberpunk Monospace) -->
		<!-- <link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" /> -->

		<!-- Font Option 4: JetBrains Mono (Original) -->
		<!-- <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" /> -->
	</head>
	<body class="font-mono antialiased bg-base-100 text-base-content">
		<div
			class={`drawer lg:drawer-open ${template.menu_left ? "drawer-end" : ""}`}
		>
			<input id="my-drawer" type="checkbox" class="drawer-toggle" />
			<div class="drawer-content relative">
				<div
					class="sticky top-0 z-10 border-b border-base-content/10 bg-base-100"
				>
					<nav class="navbar max-w-3xl mx-auto px-4">
						<div class="navbar-start">
							{template.menu_left && <DarkLightController />}
							<label
								for="my-drawer"
								class="btn btn-square btn-ghost lg:hidden"
								aria-label="Open navigation menu"
							>
								<BetterIcon>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										fill="none"
										viewBox="0 0 24 24"
										stroke-width="1.5"
										class="size-5 stroke-current"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
										></path>
									</svg>
								</BetterIcon>
							</label>
						</div>
						<div class="navbar-center lg:hidden font-mono text-sm tracking-wide">
							A. Lexian
						</div>
						<div class="navbar-end">
							{!template.menu_left && <DarkLightController />}
						</div>
					</nav>
				</div>
				<main
					class={`mx-auto flex min-h-screen flex-col justify-between py-10 lg:py-14 ${mainWidthClass}`}
				>
					<slot />
					<Footer />
				</main>
			</div>
			<div class="drawer-side z-40">
				<label
					for="my-drawer"
					aria-label="close sidebar"
					class="drawer-overlay"></label>
				<Navbar />
			</div>
		</div>
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		scroll-padding-top: 4rem;
	}

	/* Smooth, luxurious theme transitions */
	html,
	body,
	div,
	section,
	header,
	footer,
	nav,
	aside,
	main,
	article,
	a,
	button,
	span,
	p,
	h1,
	h2,
	h3,
	h4,
	h5,
	h6,
	time,
	svg,
	path {
		transition: background-color 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            color 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            border-color 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            fill 0.5s cubic-bezier(0.4, 0, 0.2, 1),
		            stroke 0.5s cubic-bezier(0.4, 0, 0.2, 1);
	}
</style>
