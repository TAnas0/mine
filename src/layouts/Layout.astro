---
import DarkLightController from "../components/ui/DarkLightController.astro";
import Navbar from "../components/ui/Navbar.astro";
import Head from "../components/Head.astro";

import { seo, profile, template } from "../settings";
import Footer from "../components/ui/Footer.astro";

type Props = {
	title?: string;
	description?: string;
	image?: string;
	contentWidth?: "default" | "reading" | "wide";
};

const {
	title = seo.default_title,
	description = seo.default_description,
	image = seo.default_image,
	contentWidth = "default",
} = Astro.props;

const mainWidthClass =
	contentWidth === "reading"
		? "max-w-[85rem] px-4 sm:px-6 lg:px-8 xl:px-12"
		: contentWidth === "wide"
			? "max-w-6xl px-4 sm:px-6 lg:px-8"
			: "max-w-2xl px-6";

const navWidthClass =
	contentWidth === "reading"
		? "max-w-[85rem] px-4 sm:px-6 lg:px-8 xl:px-12"
		: contentWidth === "wide"
			? "max-w-6xl px-4 sm:px-6 lg:px-8"
			: "max-w-3xl px-4";
---

<!doctype html>
<html lang="en">
	<head>
		<Head title={title} description={description} image={image} />
		<!-- Font Preconnect for Core Web Vitals Optimization -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Font Option 1: Fira Code (Active - Modern Developer Monospace with Ligatures) -->
		<link
			href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="font-mono antialiased bg-base-100 text-base-content min-h-screen">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-20 focus:z-50 focus:rounded focus:bg-secondary focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:text-secondary-content focus:uppercase focus:tracking-widest focus:shadow-lg"
		>
			Skip to content
		</a>

		<!-- Fixed Collapsible Navigation Sidebar (64px rail, overlays without shifting page) -->
		<Navbar />

		<!-- Main Page Shell (Offset by 4rem / 64px for the collapsed rail on mobile & desktop) -->
		<div class="relative min-h-screen pl-16 flex flex-col">
			<!-- Top Sticky Header -->
			<header
				class="sticky top-0 z-20 border-b border-base-content/10 bg-base-100/90 backdrop-blur-sm"
			>
				<nav class={`navbar mx-auto h-16 ${navWidthClass}`}>
					<div class="navbar-start">
						{template.menu_left && <DarkLightController />}
					</div>
					<div class="navbar-center font-mono text-sm tracking-wide">
						<a
							href={`${template.base}/`}
							class="hover:text-secondary transition-colors font-semibold"
						>
							{profile.fullName || "LexianOwl"}
						</a>
					</div>
					<div class="navbar-end">
						{!template.menu_left && <DarkLightController />}
					</div>
				</nav>
			</header>

			<!-- Page Main Content & Footer -->
			<main
				id="main-content"
				class={`mx-auto flex w-full flex-1 flex-col justify-between py-10 lg:py-14 ${mainWidthClass}`}
			>
				<slot />
				<Footer />
			</main>
		</div>
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		scroll-padding-top: 4rem;
	}

	/* Smooth, luxurious theme transitions */
	html,
	body,
	div,
	section,
	header,
	footer,
	nav,
	aside,
	main,
	article,
	a,
	button,
	span,
	p,
	h1,
	h2,
	h3,
	h4,
	h5,
	h6,
	time,
	svg,
	path {
		transition:
			background-color 0.5s cubic-bezier(0.4, 0, 0.2, 1),
			color 0.5s cubic-bezier(0.4, 0, 0.2, 1),
			border-color 0.5s cubic-bezier(0.4, 0, 0.2, 1),
			fill 0.5s cubic-bezier(0.4, 0, 0.2, 1),
			stroke 0.5s cubic-bezier(0.4, 0, 0.2, 1);
	}

	/* Respect user's motion preferences */
	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			transition-duration: 0.01ms !important;
			animation-duration: 0.01ms !important;
		}
	}
</style>
